# AI Studio API local proxy configuration
AISTUDIO_PORT=8090

# Browser backend: chromium or camoufox
AISTUDIO_BROWSER=chromium
AISTUDIO_BROWSER_PORT=9222
AISTUDIO_BROWSER_HEADLESS=1
# Use a relative path so the checkout can live anywhere.
AISTUDIO_BROWSER_EXECUTABLE=cloakbrowser-chromium/chrome.exe
AISTUDIO_BROWSER_CHANNEL=

# Network and local API authentication. Manage API keys in the web UI.
AISTUDIO_PROXY=
AISTUDIO_AUTH_FILE=
AISTUDIO_API_KEY_STORE=data/api_keys.json
AISTUDIO_LOCAL_UI_AUTO_LOGIN=1

# Project-relative runtime directories
AISTUDIO_ACCOUNTS_DIR=data/accounts
AISTUDIO_TMP_DIR=data/tmp
AISTUDIO_DUMP_RAW_RESPONSE_DIR=data/raw

# Model defaults
AISTUDIO_DEFAULT_TEXT_MODEL=gemini-3.7-flash
AISTUDIO_DEFAULT_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Timeouts and snapshot cache
AISTUDIO_TIMEOUT_REPLAY=120
AISTUDIO_TIMEOUT_STREAM=120
AISTUDIO_TIMEOUT_CAPTURE=30
AISTUDIO_SNAPSHOT_CACHE_TTL=3600
AISTUDIO_SNAPSHOT_CACHE_MAX=100

# Account rotation
AISTUDIO_LOGIN_BROWSER_PORT=9223
AISTUDIO_ACCOUNT_ROTATION_MODE=round_robin
AISTUDIO_ACCOUNT_COOLDOWN_SECONDS=60
AISTUDIO_ACCOUNT_MAX_RETRIES=3
AISTUDIO_MAX_CONCURRENCY=3

# Debugging
AISTUDIO_DUMP_RAW_RESPONSE=0

# Optional: use an installed Edge/Chrome instead of CloakBrowser Chromium.
# AISTUDIO_BROWSER_CHANNEL=msedge
